# Portal CENSUP — Supabase exclusivo desta ferramenta
# NÃO use SUPABASE_URL / SUPABASE_SERVICE_KEY aqui (esse é o banco do restante do portal).
# No Railway: cole no serviço BACKEND que a extensão chama (URL *.up.railway.app).
# Nomes EXATOS (não corte o final):
PORTAL_CENSUP_SUPABASE_URL=https://xxxxxxxx.supabase.co
PORTAL_CENSUP_SUPABASE_SERVICE_KEY=sb_secret_...ou jwt service_role
# Depois de salvar as variáveis: Deployments → Redeploy deste backend.
# Confira nos logs: "✅ [PortalCENSUP][Supabase] Cliente próprio criado"
# Opcional (só se algum fluxo no browser precisar)
# PORTAL_CENSUP_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# Portal CENSUP — Bot da Agenda (Railway / Playwright)
# ATENÇÃO: no Railway o SSO Akamai+Microsoft bloqueia.
# Preferir a extensão Chrome em agenda-censup-extension/ (PoC no browser logado).
AGENDA_BOT_ENABLED=false
AGENDA_BOT_BASE_URL=https://agenda-afn.go.akamai-access.com
AGENDA_BOT_LIST_PATH=/arrastadinhas
AGENDA_BOT_POLL_MS=30000
AGENDA_BOT_HEADLESS=true
AGENDA_BOT_TIMEOUT_MS=45000

# Pasta de dados (sessão + Chromium no Volume)
DATA_DIR=/data
# Opcional: se vazio, o bot usa $DATA_DIR/ms-playwright
# PLAYWRIGHT_BROWSERS_PATH=/data/ms-playwright

# Cole no Railway (JSON Playwright ou cookies exportados do Chrome)
# AGENDA_BOT_SESSION_JSON={"cookies":[...],"origins":[]}
# Ou em base64 (recomendado para JSON grande):
# AGENDA_BOT_SESSION_B64=eyJjb29raWVzIjpb...
